{
  "name": "synapsesync-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --exclude tests/lab12b/**",
    "test:lab12b": "jest --config jest.config.cjs --runInBand --coverage",
    "test:all": "npm run test && npm run test:lab12b",
    "lint": "eslint tests/lab12b"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
